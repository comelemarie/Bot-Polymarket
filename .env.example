# Copier vers .env puis remplir (chmod 600 .env). Ne JAMAIS commiter .env.
# Les valeurs ci-dessous sont masquees dans les logs.

# --- Anthropic (requis, y compris en PAPER: analyses et mots-cles) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- X / Twitter (optionnel, API v2 officielle) ---
X_BEARER_TOKEN=

# --- Polymarket / Polygon (LIVE uniquement; jamais lus en PAPER/REPLAY) ---
POLYGON_PRIVATE_KEY=
# 0 = EOA (MetaMask direct), 1 = compte email/Magic, 2 = proxy navigateur (Polymarket.com)
POLYMARKET_SIGNATURE_TYPE=1
# Adresse du proxy wallet Polymarket qui detient les USDC (requis si signature_type 1 ou 2)
POLYMARKET_FUNDER_ADDRESS=

# --- Deverrouillage du mode reel: une des 4 conditions (voir docs/LIVE.md). Laisser vide. ---
POLYBOT_LIVE_UNLOCK=
