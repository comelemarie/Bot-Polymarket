# Copier vers .env puis remplir. Ne JAMAIS commiter .env.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- X / Twitter (API v2, Bearer token de l'app) ---
X_BEARER_TOKEN=

# --- Polymarket / Polygon ---
# Cle privee du wallet qui signe les ordres (EOA ou cle exportee du compte Polymarket).
POLYGON_PRIVATE_KEY=0x...
# 0 = EOA (MetaMask direct), 1 = compte email/Magic, 2 = proxy navigateur (Polymarket.com)
POLYMARKET_SIGNATURE_TYPE=1
# Adresse du proxy wallet Polymarket qui detient les USDC (requis si signature_type 1 ou 2).
POLYMARKET_FUNDER_ADDRESS=0x...
